# ==============================================================================
# System Resource Monitor - Git Ignore Configuration
# Comprehensive Exclusion of Sensitive, Machine-Specific, and Generated Files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Protection (MANDATORY)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development
.env.production
.env.test
!.env.example

# Credentials, Keys, and Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
*id_rsa*
*id_ed25519*
*credentials*
*secret*
*.token

# ------------------------------------------------------------------------------
# 2. Python Artifacts & Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build Outputs
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
dist/
build/
.output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# Vite & Bundler Caches
.vite/
frontend/.vite/

# ------------------------------------------------------------------------------
# 4. Databases & Telemetry Storage (Personal Data Protection)
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db-wal
*.db-shm

# ------------------------------------------------------------------------------
# 5. OS & Machine-Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configurations
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/
*.swp
*.swo
*~
*.bak
*.tmp
*.temp

# Keep VS Code recommended settings if present, but exclude workspace caches
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json


# Test Temporary Directories
.test_tmp/
.test_db/
backend/tests/.test_tmp/

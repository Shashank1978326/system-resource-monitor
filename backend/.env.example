APP_TITLE=System Resource Monitor API
APP_DESCRIPTION=Cross-platform system resource monitor backend API
APP_VERSION=0.1.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MONITORING_INTERVAL_SECONDS=1
# Resource alert state transitions; critical must be higher than warning.
CPU_ALERT_WARNING_THRESHOLD_PERCENT=80
CPU_ALERT_CRITICAL_THRESHOLD_PERCENT=90
RAM_ALERT_WARNING_THRESHOLD_PERCENT=80
RAM_ALERT_CRITICAL_THRESHOLD_PERCENT=90
DISK_ALERT_WARNING_THRESHOLD_PERCENT=80
DISK_ALERT_CRITICAL_THRESHOLD_PERCENT=90
# Temperature alert levels in °C; use finite, non-negative values with warning below critical.
TEMPERATURE_ALERT_WARNING_THRESHOLD_CELSIUS=80
TEMPERATURE_ALERT_CRITICAL_THRESHOLD_CELSIUS=90
# How often the latest collected snapshot is sent to WebSocket clients.
WEBSOCKET_PUBLISH_INTERVAL_SECONDS=1
# Historical samples older than this many days are removed once per day.
HISTORY_RETENTION_DAYS=30
# Optional: set a custom directory for history.sqlite3.
# APP_DATA_DIR=C:\Users\YourName\AppData\Local\SystemResourceMonitor

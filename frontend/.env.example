# System Resource Monitor - Frontend Environment Variables Example
# Copy this file to .env or .env.local for local overrides.
# Never commit real secrets or production credentials to version control.

# Backend REST & WebSocket API Base URL
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Landing Page Mode:
# Leave commented or set to "dashboard" to have "/" load the live dashboard.
# Set to "showcase" to have "/" load the portfolio showcase landing page (ideal for public portfolio hosting).
# VITE_LANDING_PAGE=showcase
